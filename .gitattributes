# Normalize line endings for all text files to LF in the repository.
# Git will convert to the OS native line endings on checkout.
* text=auto eol=lf

# Explicitly declare these as binary so Git never tries to convert them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
